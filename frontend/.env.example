# ─── API ──────────────────────────────────────────────────
# Leave empty to use Vite proxy (recommended for dev)
# Set to full URL only for production builds (e.g. https://api.yourdomain.com)
VITE_API_URL=

# ─── Google OAuth ─────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_client_id
